{
 "trap_vocabulary": {
  "region-mismatch": "input.region (the user's phone_region) differs from the card's country",
  "region-from-plus-cc": "numbers carry +cc, so the region setting must not matter",
  "region-from-address": "national numbers; the printed address country decides",
  "region-from-cctld": "no address; the e-mail/web ccTLD is the only country evidence",
  "region-from-other-number": "no address, generic TLD; another number on the card has +cc",
  "region-stays-low": "no address, generic TLD, no +cc: country unknowable — must not be high confidence",
  "region-trap-valid-elsewhere": "the national number is also valid/plausible in the phone_region country",
  "region-mismatch-ui-script": "UI language script decides the primary name (N7)",
  "tagline-not-title": "tagline / slogan / \"Head Office\" / \"Est. 19xx\" line that must not become the title",
  "group-line-not-company": "\"A member of … Group\", \"Part of …\", \"Eine Marke der …\", \"Une société du Groupe …\"",
  "credential-suffix": "credential after the name (PT, DPT, CPA, LL.M., MBA, WP, StB, FCCA, MRICS, PhD, …) — not company",
  "prefix-title": "academic/professional prefix (RA, Dr.-Ing., Mag., Dott., ir., mgr inż., Ing., Lic., Av., Eng.ª)",
  "legal-form-line": "legal form alone on its own line (\"GmbH\", \"NV\", \"e.K.\", \"Sp. z o.o.\", 有限会社)",
  "legal-form-prefix": "legal form printed before the name (PT …, (주), 주식회사)",
  "legal-form-unknown": "legal form outside the usual dictionaries (K.K.)",
  "title-dept-one-line": "title and department printed on one line (\"Leiter Vertrieb Süd\", \"Senior Engineer, R&D\")",
  "name-is-company": "the person's name (or family name) is also in the company name",
  "name-equals-domain": "domain stem equals the person's name — company must stay absent",
  "combined-label": "one label for two kinds (Tel./Fax, Phone/Fax, Mobil/Fax, T/F, Cel./WhatsApp)",
  "durchwahl-composed": "number printed only as a suffix of another (Durchwahl -12, DW 15, Fax -99)",
  "ext-pair": "two numbers share a base (extensions, or Tel/Fax differing in the last digits)",
  "ext-in-number": "German direct-dial suffix \"-31\" is part of the number",
  "extension": "\"x 318\" / \"ext. 204\" extension, not part of E.164",
  "vanity-number": "letters in the number (1-800-GO-PLUMB)",
  "toll-free": "toll-free / service number (1-800, 0120)",
  "trunk-in-brackets": "\"+44 (0)20\" — the bracketed trunk 0 must be dropped",
  "trunk-8-ru": "Russian trunk prefix 8",
  "italian-leading-zero": "Italian landline keeps its 0 after +39",
  "cc-in-brackets": "country code in brackets without \"+\" (\"(852)\")",
  "area-code-brackets": "area code in brackets \"(030)\", \"(0172)\"",
  "slash-in-number": "\" / \" between area code and number (also a segment separator in SPEC §5.1 rule 1)",
  "slash-in-address": "\" / \" inside the address line",
  "postcode-like-phone": "postcode digits match a phone prefix on the same card",
  "vat-id": "VAT number (USt-IdNr., MWST, TVA, P.IVA, BTW, DIČ, VAT Reg.) — not a phone",
  "tax-id": "tax number (Steuernummer, NIF, CIF, NIP, Vergi No, GSTIN, NPWP, MST, TRN, ИНН, RFC, 統一編號)",
